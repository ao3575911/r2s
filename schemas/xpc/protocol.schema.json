{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ao3575911.github.io/xpc/schemas/protocol.schema.json",
  "title": "XPC Protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "hypothesis_id", "steps", "environment"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "hypothesis_id": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "action"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "action": { "type": "string", "minLength": 1 },
          "expect": { "type": "string" }
        }
      }
    },
    "controls": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["local", "ci", "lab", "other"] },
        "detail": { "type": "string" }
      }
    },
    "inputs": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "notes": { "type": "string" }
  }
}
