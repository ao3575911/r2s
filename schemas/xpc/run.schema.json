{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ao3575911.github.io/xpc/schemas/run.schema.json",
  "title": "XPC Run",
  "description": "Binds one hypothesis + protocol + optional result into a single experiment cycle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "hypothesis_id", "protocol_id", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "hypothesis_id": { "type": "string", "minLength": 1 },
    "protocol_id": { "type": "string", "minLength": 1 },
    "result_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["planned", "running", "complete", "aborted"]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  }
}
